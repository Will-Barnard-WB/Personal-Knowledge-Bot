# Personal Knowledge Bot — copy to .env and fill in. Do NOT commit .env.

  # Claude / Anthropic (REQUIRED)
  ANTHROPIC_API_KEY=sk-ant-xxxxx

  # Models (optional defaults)
  CLAUDE_FAST_MODEL=claude-haiku-4-5
  CLAUDE_SMART_MODEL=claude-haiku-4-5
  WHISPER_MODEL=base
  
  # Database (REQUIRED — defaults match docker-compose)
  DATABASE_URL=postgresql+asyncpg://pkb:pkbpassword@localhost:5432/personal_knowledge_bot

  # Redis (REQUIRED)
  REDIS_URL=redis://localhost:6379

  # App
  APP_HOST=0.0.0.0
  APP_PORT=8000
  LOG_LEVEL=INFO

  # WhatsApp gateway
  GATEWAY_URL=http://localhost:3000
  WEBHOOK_URL=http://localhost:8000/webhook
  MY_WHATSAPP_ID=

  # Telegram gateway  
  TELEGRAM_GATEWAY_URL=http://localhost:3001
  TELEGRAM_WEBHOOK_URL=http://localhost:8000/telegram-webhook
  MY_TELEGRAM_ID=
  
  # Rate limiting / workers
  RATE_LIMIT_MAX_REQUESTS=10
  RATE_LIMIT_WINDOW_SECONDS=60
  ARQ_MAX_JOBS=5